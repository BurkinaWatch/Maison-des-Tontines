# Database
DATABASE_URL="postgresql://tontine:tontine@localhost:5432/maison_tontines?schema=public"

# API
API_URL="http://localhost:3000/api"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Authentication
JWT_SECRET="your-secret-key-here"
JWT_EXPIRY="7d"
REFRESH_TOKEN_SECRET="your-refresh-secret-here"

# External Services
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
SENDGRID_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# App Configuration
NEXT_PUBLIC_APP_NAME="Maison des Tontines"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="XOF"
NEXT_PUBLIC_DEFAULT_COUNTRY="CI"

# Feature Flags
NEXT_PUBLIC_ENABLE_NOTIFICATIONS="true"
NEXT_PUBLIC_ENABLE_BIOMETRICS="true"
NEXT_PUBLIC_ENABLE_PENDING_MEMBERS="true"

# Monitoring
SENTRY_DSN=""
LOG_LEVEL="info"

# File Upload
MAX_FILE_SIZE_MB="10"
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"

# Tontine Configuration
DEFAULT_CONTRIBUTION_AMOUNT="10000"
DEFAULT_CYCLE_DURATION_DAYS="30"
MAX_TONTINE_MEMBERS="50"
MIN_TONTINE_MEMBERS="3"
