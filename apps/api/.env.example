NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maison_tontines?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-in-production-access-secret-key-at-least-32-chars
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret-key-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=mt

# OTP (simulation)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RATE_LIMIT_MINUTES=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payment providers
MOCK_PROVIDER_ENABLED=true
WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_WEBHOOK_SECRET=
WAVE_BASE_URL=https://api.wave.com

# Notification providers
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@maisondestontines.com
PUSH_PROVIDER=
PUSH_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# File uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# AI
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4
