generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model OtpVerification {
  id        String    @id @default(cuid())
  phone     String    @unique 
  otp       String    
  expiresAt DateTime  
  createdAt DateTime  @default(now()) 

  @@index([phone])
  @@index([expiresAt])
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique 
  email         String?    @unique 
  name          String     
  passwordHash  String     
  role          String   @default("MEMBER")
  status        String @default("ACTIVE")
  createdAt     DateTime   @default(now()) 
  updatedAt     DateTime   @default(now()) @updatedAt 

  tontineMemberships TontineMember[]
  createdTontines    Tontine[]
  votesOpened        Vote[]
  disputesOpened     Dispute[] @relation("DisputeOpenedBy")
  disputesResolved   Dispute[] @relation("DisputeResolvedBy")
  trustProfile       TrustProfile?
  auditLogs          AuditLog[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  sessions           Session[]
  aiConversations    AIConversation[]
  confirmedContributions Contribution[] @relation("ConfirmedByUser")

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([status])
}

model Tontine {
  id                String      @id @default(cuid())
  name              String      
  description       String?     
  type              String @default("ROTATIVE")
  currency          String      @default("XOF") 
  contributionAmount Float    
  frequency         String      
  startDate          DateTime    
  endDate            DateTime?   
  status            String @default("DRAFT")
  maxMembers         Int?
  createdAt         DateTime    @default(now()) 
  updatedAt         DateTime    @default(now()) @updatedAt 
  createdById       String

  createdBy         User             @relation(fields: [createdById], references: [id])
  rules             TontineRule[]
  members           TontineMember[]
  cycles            TontineCycle[]
  votes             Vote[]
  disputes          Dispute[]
  aiConversations   AIConversation[]
  aiInsights        AIInsight[]
  payouts           Payout[]

  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([startDate])
}

model TontineRule {
  id        String @id @default(cuid())
  tontineId String
  key       String 
  value     String 
  type      String @default("STRING") 

  tontine Tontine @relation(fields: [tontineId], references: [id], onDelete: Cascade)

  @@index([tontineId])
  @@index([tontineId, key])
}

model TontineMember {
  id               String    @id @default(cuid())
  tontineId        String
  userId           String
  role             String    @default("MEMBER") 
  status           String    @default("ACTIVE") 
  joinedAt         DateTime  @default(now()) 
  leftAt           DateTime? 
  payoutOrder      Int?
  isPayoutReceived Boolean   @default(false)

  tontine  Tontine    @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id])
  votes    VoteBallot[]
  payouts  Payout[]
  contributions Contribution[]
  beneficiaryCycles TontineCycle[] @relation("CycleBeneficiary")

  @@index([tontineId])
  @@index([userId])
  @@index([tontineId, userId])
  @@index([tontineId, status])
}

model TontineCycle {
  id                String       @id @default(cuid())
  tontineId         String
  sequence          Int
  name              String       
  startDate         DateTime     
  endDate           DateTime?    
  status            String  @default("UPCOMING")
  beneficiaryMemberId String?
  potAmount         Float?     
  potReceived       Float?     @default(0) 
  createdAt         DateTime     @default(now()) 
  updatedAt         DateTime     @default(now()) @updatedAt 

  tontine         Tontine           @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  beneficiary     TontineMember?    @relation("CycleBeneficiary", fields: [beneficiaryMemberId], references: [id])
  contributions   Contribution[]
  payouts         Payout[]

  @@index([tontineId])
  @@index([tontineId, sequence])
  @@index([status])
  @@index([startDate])
}

model Contribution {
  id            String              @id @default(cuid())
  cycleId       String
  memberId      String
  amount        Float             
  status        String  @default("PENDING")
  method        String              @default("MANUAL") 
  providerRef   String?             
  declaredAt    DateTime            @default(now()) 
  confirmedAt   DateTime?           
  confirmedById String?
  lateFee       Float             @default(0) 
  penaltyApplied Boolean           @default(false)
  notes         String?             

  cycle         TontineCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  member        TontineMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  confirmedBy   User?              @relation("ConfirmedByUser", fields: [confirmedById], references: [id])
  disputes      Dispute[]          @relation("ContributionDisputes")

  @@index([cycleId])
  @@index([memberId])
  @@index([cycleId, memberId])
  @@index([status])
  @@index([declaredAt])
}

model Payout {
  id            String     @id @default(cuid())
  tontineId     String
  cycleId       String
  memberId      String
  amount        Float    
  status        String @default("PENDING")
  method        String     @default("MANUAL") 
  providerRef   String?    
  initiatedAt   DateTime   @default(now()) 
  completedAt   DateTime?  
  failureReason String?    

  tontine  Tontine        @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  cycle    TontineCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  member   TontineMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tontineId])
  @@index([cycleId])
  @@index([memberId])
  @@index([status])
  @@index([initiatedAt])
}

model PaymentProvider {
  id             String  @id @default(cuid())
  name           String  @unique 
  type           String  
  config         String
  isActive       Boolean @default(true)
  apiKeyRef      String? 
  webhookSecretRef String? 
  createdAt      DateTime @default(now()) 

  transactions PaymentTransaction[]

  @@index([type])
  @@index([isActive])
}

model PaymentTransaction {
  id           String   @id @default(cuid())
  providerId   String
  providerRef  String   
  amount       Float  
  currency     String   @default("XOF") 
  status       String   
  direction    String   
  metadata     String
  createdAt    DateTime @default(now()) 
  updatedAt    DateTime @default(now()) @updatedAt 

  provider PaymentProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([providerRef])
  @@index([status])
  @@index([createdAt])
}

model Vote {
  id              String      @id @default(cuid())
  tontineId       String
  question        String      
  options         String
  status          String  @default("DRAFT")
  quorum          Int         @default(0)
  eligibleVoterIds String
  result          String?     
  openedAt        DateTime?   
  closedAt        DateTime?   
  createdById     String

  tontine   Tontine       @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
  ballots   VoteBallot[]

  @@index([tontineId])
  @@index([status])
  @@index([openedAt])
}

model VoteBallot {
  id        String    @id @default(cuid())
  voteId    String
  memberId  String
  choice    String    
  votedAt   DateTime  @default(now()) 

  vote   Vote          @relation(fields: [voteId], references: [id], onDelete: Cascade)
  member TontineMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([voteId])
  @@index([memberId])
  @@unique([voteId, memberId])
}

model Dispute {
  id           String         @id @default(cuid())
  tontineId    String
  cycleId      String?
  contributionId String?
  type         String         
  description  String         
  status       String  @default("OPEN")
  openedById   String
  openedAt     DateTime       @default(now()) 
  resolvedAt   DateTime?      
  resolvedById String?
  decision     String?        

  tontine      Tontine         @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  openedBy     User            @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  resolvedBy   User?           @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  contribution Contribution?  @relation("ContributionDisputes", fields: [contributionId], references: [id])
  evidence     DisputeEvidence[]

  @@index([tontineId])
  @@index([cycleId])
  @@index([status])
  @@index([openedAt])
}

model DisputeEvidence {
  id        String   @id @default(cuid())
  disputeId String
  url       String   
  description String? 
  uploadedAt  DateTime @default(now()) 

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

model TrustProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  cyclesCompleted    Int      @default(0)
  paymentsOnTime     Int      @default(0)
  paymentsLate       Int      @default(0)
  disputesResolved   Int      @default(0)
  disputesUnresolved Int      @default(0)
  memberSince        DateTime @default(now()) 
  score              Int      @default(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String   
  action     String   
  resource   String   
  resourceId String?  
  metadata   String
  ipAddress  String   
  createdAt  DateTime @default(now()) 

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@index([action])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  tontineId String?
  messages  String
  createdAt DateTime @default(now()) 

  user    User     @relation(fields: [userId], references: [id])
  tontine Tontine? @relation(fields: [tontineId], references: [id])

  @@index([userId])
  @@index([tontineId])
  @@index([createdAt])
}

model AIInsight {
  id        String   @id @default(cuid())
  tontineId String
  type      String   
  data      String
  priority  String   @default("LOW") 
  createdAt DateTime @default(now()) 

  tontine Tontine @relation(fields: [tontineId], references: [id], onDelete: Cascade)

  @@index([tontineId])
  @@index([priority])
  @@index([createdAt])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      String
  channel   String
  title     String            
  body      String            
  data      String
  status    String @default("PENDING")
  sentAt    DateTime?         
  readAt    DateTime?         
  createdAt DateTime          @default(now()) 

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique 
  expiresAt DateTime 
  revokedAt DateTime? 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique 
  expiresAt  DateTime 
  ipAddress  String   
  userAgent  String?  
  createdAt  DateTime @default(now()) 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
