{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://maison-des-tontines-production.up.railway.app",
        "EXPO_PUBLIC_API_VERSION": "v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://maison-des-tontines-production.up.railway.app",
        "EXPO_PUBLIC_API_VERSION": "v1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}